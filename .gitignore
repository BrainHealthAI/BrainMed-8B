# ---- model weights -------------------------------------------------------------------
# 16GB per checkpoint against GitHub's 100MB file limit. The weights live on the
# Hugging Face Hub: https://huggingface.co/BrainHealthAI/BrainMed-8B
ckpts/
*.safetensors
*.bin
*.pt
*.pth

# ---- derived inputs, rebuilt by the pipeline -----------------------------------------
# Rebuilding requires the exact historical source revisions. The benchmark manifest is
# committed; the historical prepared-data manifest is not. Do not imply byte identity
# merely because these scripts can fetch current upstream data.
data/prepared/
eval/benchmarks/*.jsonl
external/
.tokcache/
.hf/

# ---- run artefacts -------------------------------------------------------------------
results/*/logs/
results/_card/
train_logs/*/wandb/
logs/
state/
*.tgz
*.tar.gz

# ---- python --------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ---- credentials ---------------------------------------------------------------------
.env
*.pem
*token*.json
